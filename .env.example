# ==============================================================================
# AI Interview Coach — Environment Configuration Template (.env.example)
# Copy this file to .env and configure the variables as needed.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=False

# JWT Secret Key for Session Authentication (Change to a strong random key in production)
SECRET_KEY=your_secure_jwt_secret_key_change_in_production_here
ACCESS_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./data/interview_coach.db

# Speech-to-Text Model Size (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=small

# Optional: Cloud / LLM API Keys (if using remote inference endpoints)
# HUGGINGFACE_API_TOKEN=your_huggingface_token_here
# ALIBABA_CLOUD_API_KEY=your_alibaba_cloud_key_here
# QWEN_API_KEY=your_dashscope_qwen_key_here
